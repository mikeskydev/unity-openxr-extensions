<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <TestEditor Condition="'$(TestEditor)' == ''">true</TestEditor>
    <DefineConstants Condition="'$(TestEditor)' == 'true'">$(DefineConstants);UNITY_EDITOR</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InterceptorSource Condition="'$(InterceptorSource)' == ''">../../Runtime/Utils/FeatureBase.cs</InterceptorSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(InterceptorSource)" Link="FeatureBase.cs" />
    <Compile Include="UnityStubs.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
